--p1,p2 จุดหยิบของ
--p3,p4 จุดปล่อยของบนถาด
-- p5 จุดหยิบของบนถาด
-- p6,p7 จุดปล่อยของ

Go(InitialPose)
DO(1, OFF)
DO(2, OFF)
DO(9, OFF)
Wait(2000)

Sync()
while (true) do
  Sync()
  if DI(16) == 0 --ไม่มีของให้ไปหยิบมาวาง
  then
    MovL(P1)
    MovL(P2)
    DO(1,ON)
    Wait(500)
    MovL(P1)
    MovL(InitialPose)

    MovL(P3)
    MovL(P4)
    DO(1,OFF)
    DO(2,ON)
    Wait(500)
    DO(2,OFF)
    MovL(P3)
    Wait(1000)

    Sync()
    if DI(16) == 1 --มีของให้หมุนถาด
    then
        DO(9, ON)
        Wait(860)
        DO(9, OFF)
      else
        Go(InitialPose)
    end
    Sync()
    
  else --มีของในถาดให้หยิบออกมาปล่อย
    MovL(P3)
    MovL(P5)
    DO(1,ON)
    Wait(500)
    MovL(P3)
    MovL(P7)
    MovL(P6)
    DO(1,OFF)
    DO(2,ON)
    Wait(500)
    DO(2,OFF)
    Go(InitialPose)

    DO(9, ON)
    Wait(980)
    DO(9, OFF)
    
  end
  Sync()
end
Sync()
